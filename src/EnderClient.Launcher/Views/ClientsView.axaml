<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EnderClient.Launcher.Views.ClientsView">

    <Grid RowDefinitions="Auto,Auto,*">

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Clients" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Add a client DLL (e.g. Latite.dll) to inject on launch." Foreground="{StaticResource MutedForegroundBrush}" FontSize="13"/>
        </StackPanel>

        <Button Grid.Row="1" Name="AddClientButton" Classes="secondary" Content="+ Add client" HorizontalAlignment="Left" Margin="0,16,0,16"/>

        <ScrollViewer Grid.Row="2">
            <StackPanel Name="ClientListPanel" Spacing="8"/>
        </ScrollViewer>

    </Grid>

</UserControl>
