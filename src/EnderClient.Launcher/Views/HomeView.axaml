<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EnderClient.Launcher.Views.HomeView">

    <Grid RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Home" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Select a client and launch Minecraft." Foreground="{StaticResource MutedForegroundBrush}" FontSize="13"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="10" MaxWidth="360">
            <TextBlock Text="Client" FontSize="12" Foreground="{StaticResource MutedForegroundBrush}"/>
            <ComboBox Name="ClientSelector" HorizontalAlignment="Stretch" PlaceholderText="Vanilla (no client)"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="10">
            <TextBlock Name="StatusText" Foreground="{StaticResource MutedForegroundBrush}" FontSize="13"/>
            <Button Name="LaunchButton" Classes="primary" Content="Launch" HorizontalAlignment="Left" MinWidth="180"/>
        </StackPanel>

    </Grid>

</UserControl>
