<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EnderClient.Launcher.Views.HomeView">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Name="RootGrid">

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Home" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Select a client and launch Minecraft." Foreground="{StaticResource MutedForegroundBrush}" FontSize="13"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8" MaxWidth="360" HorizontalAlignment="Center" Margin="0,20,0,0">
            <TextBlock Text="Client" FontSize="12" Foreground="{StaticResource MutedForegroundBrush}" HorizontalAlignment="Left"/>
            <ComboBox Name="ClientSelector" HorizontalAlignment="Stretch" PlaceholderText="Vanilla (no client)"/>
        </StackPanel>

        <NativeWebView Grid.Row="2" Name="HeadView" Width="200" Height="200"
                       NavigationCompleted="OnHeadViewNavigationCompleted"/>

        <StackPanel Grid.Row="3" Spacing="10" MaxWidth="420" HorizontalAlignment="Center" Margin="0,0,0,8">
            <TextBlock Name="StatusText" Foreground="{StaticResource MutedForegroundBrush}" FontSize="13" HorizontalAlignment="Center"/>
            <Button Name="LaunchButton" Classes="primary" Content="Launch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        </StackPanel>

    </Grid>

</UserControl>
