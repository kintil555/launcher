{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ender Client",
  "version": "0.1.0",
  "identifier": "com.enderclient.launcher",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ender Client",
        "width": 1180,
        "height": 860,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' data: ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**/custom_skins/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
