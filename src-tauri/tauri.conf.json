{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ender Client",
  "version": "0.1.4",
  "identifier": "com.enderclient.launcher",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ender Client",
        "width": 1180,
        "height": 720,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https://cdn.discordapp.com; connect-src 'self' data: ipc: http://ipc.localhost https://github.com https://objects.githubusercontent.com",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/custom_skins/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4Qzg4NTQyQjQwMzdCRUIKUldUcmV3TzBRb1hJT0IrQ2Q2RUsybmhTeDJBd3E3UytLQkJBMWdOVUNKYlVLMmpnUnowNnFYakgK",
      "endpoints": [
        "https://github.com/kintil555/launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
